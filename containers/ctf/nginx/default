server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;
    root /var/www/html;
    index index.html;

    # This flag requires code execution as www-data, not a static HTTP download.
    location = /flag.txt {
        return 404;
    }

    location = /_health {
        access_log off;
        proxy_pass http://127.0.0.1:5000/_health;
    }

    # Forum submit endpoint proxied to internal backend
    location /forum/submit {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static routes
    location / {
        try_files $uri $uri/ =404;
    }
}
