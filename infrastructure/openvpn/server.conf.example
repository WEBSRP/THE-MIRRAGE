# =========================================================
# MIRRAGE PLATFORM - OPENVPN SERVER CONFIGURATION (EC2)
# =========================================================

port 1194
proto udp
dev tun

# SSL/TLS Root Certificate & Keys
ca /etc/openvpn/server/ca.crt
cert /etc/openvpn/server/server.crt
key /etc/openvpn/server/server.key
dh /etc/openvpn/server/dh.pem

# VPN Subnet allocated for players
server 10.8.0.0 255.255.255.0

# Route Kubernetes sandbox pod CIDR to players
push "route 10.42.0.0 255.255.0.0"

# Maintain IP associations
ifconfig-pool-persist /var/log/openvpn/ipp.txt

# Security & Ciphers
cipher AES-256-GCM
auth SHA256
keepalive 10 120
persist-key
persist-tun

# Logging and live status log (parsed by FastAPI vpn_service)
status /var/log/openvpn/openvpn-status.log 5
status-version 2
log-append /var/log/openvpn/openvpn.log
verb 3
mute 20
