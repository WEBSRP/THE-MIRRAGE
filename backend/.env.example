# =========================================================
# MIRRAGE BACKEND - ENVIRONMENT CONFIGURATION
# =========================================================
# Copy this file to .env and fill in production values.
# NEVER commit the actual .env file.

# General
ENVIRONMENT=development
PROJECT_NAME="MIRRAGE API"
SECRET_KEY=your-secure-random-jwt-secret-key-that-is-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local dev: sqlite+aiosqlite:///./mirrage.db
# Production: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=sqlite+aiosqlite:///./mirrage.db

# CORS Allowed Origins
# Production should include: https://themirrage.me, https://www.themirrage.me
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Session Constraints
MAX_CONCURRENT_SESSIONS=3
SESSION_TIMEOUT_MINUTES=30
SESSION_CLEANUP_INTERVAL_SECONDS=60

# Kubernetes Engine (k3s / EKS)
# Set to 'production' for live k3s, 'mock' for simulated sessions
K8S_MODE=mock
K8S_NAMESPACE=mirrage-sessions
K8S_IN_CLUSTER=false
K8S_KUBECONFIG_PATH=~/.kube/config
MIRAGE_CONTAINER_IMAGE=mirrage/mirage-honeypot:latest
CTF_CONTAINER_IMAGE=mirrage/ctf-core:latest

# OpenVPN Engine
# Set to 'production' for live OpenVPN, 'mock' for simulated VPN
VPN_MODE=mock
OPENVPN_SERVER_HOST=vpn.mirrage.internal
OPENVPN_SERVER_PORT=1194
OPENVPN_STATUS_LOG_PATH=/var/log/openvpn/openvpn-status.log

# Production safety override
# Set to true to allow mock K8S/VPN in production during development
ALLOW_MOCK_IN_PRODUCTION=false
