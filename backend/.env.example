# =========================================================
# MIRRAGE BACKEND - ENVIRONMENT CONFIGURATION
# =========================================================
# Copy this file to .env and fill in production values.
# NEVER commit the actual .env file.

# General
ENVIRONMENT=development
PROJECT_NAME="MIRRAGE API"

# JWT signing secret
SECRET_KEY=

# Dedicated HMAC secret for Email OTP
OTP_HMAC_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local dev: sqlite+aiosqlite:///./mirrage.db
# Production: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=sqlite+aiosqlite:///./mirrage.db

# Shared CTF flags: relative to backend/ or an absolute private path.
# Empty uses ctf-flags.example.json ONLY in development/testing.
# Production MUST supply a private JSON file with three distinct random flags.
CTF_FLAGS_FILE=
FLAG_SUBMISSIONS_PER_WINDOW=10
FLAG_SUBMISSION_WINDOW_SECONDS=60

# Email provider
# Production supports resend or sendgrid. SMTP is unsupported and fails startup.
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Sender identity
EMAIL_FROM=
EMAIL_FROM_NAME=MIRRAGE
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_SECONDS=10
EMAIL_HEALTH_RETENTION_DAYS=7

# OTP settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_RATE_LIMIT_WINDOW_MINUTES=30
# WARNING: OTP_DEV_MODE=true is REJECTED in ENVIRONMENT=production (fails closed)
OTP_DEV_MODE=false
OTP_IP_REQUEST_LIMIT=10
OTP_IP_WINDOW_SECONDS=600
OTP_EMAIL_HOURLY_LIMIT=100
OTP_EMAIL_DAILY_LIMIT=500
OTP_IP_BUCKET_RETENTION_SECONDS=86400
# Empty for direct local development; host Nginx deployment uses ["127.0.0.1/32","::1/128"].
OTP_TRUSTED_PROXY_CIDRS=[]


# CORS Allowed Origins
# Development origins for local dev; production adds themirrage.me domains automatically via config.py defaults
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Session Constraints
MAX_CONCURRENT_SESSIONS=3
SESSION_TIMEOUT_MINUTES=30
SESSION_CLEANUP_INTERVAL_SECONDS=60

# Kubernetes Engine (k3s / EKS)
# Set to 'production' for live k3s, 'mock' for simulated sessions
K8S_MODE=mock
K8S_NAMESPACE=mirrage-sessions
K8S_IN_CLUSTER=false
K8S_KUBECONFIG_PATH=~/.kube/config
MIRAGE_CONTAINER_IMAGE=mirrage/mirage-honeypot:latest
CTF_CONTAINER_IMAGE=mirrage/ctf-core:latest

# OpenVPN Engine
# Set to 'production' for live OpenVPN, 'mock' for simulated VPN
VPN_MODE=mock
VPN_DOWNLOAD_LIMIT_PER_SESSION=3
OPENVPN_SERVER_HOST=vpn.mirrage.internal
OPENVPN_SERVER_PORT=1194
OPENVPN_PROTO=udp
OPENVPN_STATUS_LOG_PATH=/var/log/openvpn/status.log
VPN_CLIENT_CIDR=10.8.0.0/24
VPN_CLIENT_IP_START=10.8.0.10
VPN_CLIENT_IP_END=10.8.0.250
OPENVPN_CCD_DIR=/var/lib/mirrage/openvpn/ccd
OPENVPN_TUN_INTERFACE=tun0
SESSION_POD_CIDR=10.42.0.0/16
SESSION_POD_INTERFACE=cni0
# Required for real sessions: exact k3s node name hosting VPN and the gateway.
K8S_SESSION_NODE_NAME=
# Only owner-directed TCP callbacks on these ports are allowed; [] disables them.
SESSION_CALLBACK_PORTS=[4444]
SESSION_GATEWAY_HELPER=/usr/local/sbin/mirrage-session-access

# Easy-RSA / Production VPN Provisioning
# Only needed when VPN_MODE=production
EASYRSA_DIR=~/openvpn-ca
EASYRSA_CA_CERT=~/openvpn-ca/pki/ca.crt
EASYRSA_TLS_KEY=~/openvpn-ca/ta.key
VPN_CA_PASSPHRASE_FILE=/etc/mirrage/vpn-ca-passphrase
VPN_CLIENT_NAME_PREFIX=mirrage
VPN_CONTROL_HELPER=/usr/local/sbin/mirrage-vpn-control
VPN_PKI_TIMEOUT_SECONDS=45
VPN_REVOCATION_RETRY_SECONDS=30
VPN_CRL_CHECK_INTERVAL_SECONDS=3600
VPN_CRL_REFRESH_MARGIN_SECONDS=604800

# Production safety override
# Set to true to allow mock K8S/VPN in production during development
ALLOW_MOCK_IN_PRODUCTION=false
